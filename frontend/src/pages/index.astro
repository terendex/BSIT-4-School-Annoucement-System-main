---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnnouncementCard from "../components/AnnouncementCard.astro";
import { getFeedState, getTaxonomy, listAnnouncements } from "../lib/api";
import { LOGO_PATH, SITE_NAME, SITE_TAGLINE } from "../lib/config";

const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1") || 1);
const search = (Astro.url.searchParams.get("q") ?? "").trim();
const category = (Astro.url.searchParams.get("category") ?? "").trim();
const year = (Astro.url.searchParams.get("year") ?? "").trim();
const section = (Astro.url.searchParams.get("section") ?? "").trim();

const filters = { search, category, year, section };
const [data, taxonomy, feedState] = await Promise.all([
  listAnnouncements(page, filters),
  getTaxonomy(),
  getFeedState(filters),
]);

// Category slug -> tone, so a card badge and its filter always agree.
const toneFor = (slug: string) =>
  taxonomy.categories.find((item) => item.slug === slug)?.tone ?? "neutral";

// Straight from /api/feed-state/, which is exactly what AutoRefresh polls -
// with the same filters, so the two agree unless something really changed.
// (Building this from the rendered rows would break on any search or on
// page 2, where the newest edit may not be among the rows on screen.)
const refreshSignature = `${feedState.count}:${feedState.last_modified ?? ""}`;
const refreshParams = new URLSearchParams();
if (search) refreshParams.set("q", search);
if (category) refreshParams.set("category", category);
if (year) refreshParams.set("year", year);
if (section) refreshParams.set("section", section);
const refreshQuery = refreshParams.toString();

const hasPrev = Boolean(data.previous);
const hasNext = Boolean(data.next);

/** Keep the active filters while turning the page. */
const pageHref = (target: number) => {
  const params = new URLSearchParams(refreshQuery);
  if (target > 1) params.set("page", String(target));
  const query = params.toString();
  return query ? `/?${query}` : "/";
};

const activeCategory = taxonomy.categories.find((item) => item.slug === category);
const activeYear = taxonomy.year_levels.find((item) => item.slug === year);
const activeSection = taxonomy.sections.find((item) => item.slug === section);
const isFiltered = Boolean(search || category || year || section);

// Who the list has been narrowed to, if anyone: "4th year", "Section A", or
// both. Used in the summary line under the filter bar.
const narrowedTo = [
  activeYear && activeYear.slug !== "all" ? activeYear.name : "",
  activeSection && activeSection.slug !== "all" ? activeSection.name : "",
]
  .filter(Boolean)
  .join(", ");
---

<BaseLayout
  title={SITE_NAME}
  description={SITE_TAGLINE}
  canonicalPath="/"
  refreshSignature={refreshSignature}
  refreshQuery={refreshQuery}
>
  <div class="page-heading">
    <h1>Announcements</h1>
    <span class="count-pill">
      {data.count} {data.count === 1 ? "post" : "posts"}
    </span>
  </div>

  <!--
    A plain GET form, so filtering still works with JavaScript switched off and
    every filtered view keeps its own shareable URL. The inline script at the
    bottom only removes the need to press Apply.
  -->
  <form class="filterbar" method="get" action="/" role="search" id="filter-form">
    <div class="filterbar__field filterbar__field--grow">
      <label class="filterbar__label" for="filter-q">Search</label>
      <input
        class="input"
        id="filter-q"
        type="search"
        name="q"
        value={search}
        placeholder="Search announcements..."
      />
    </div>

    <div class="filterbar__field">
      <label class="filterbar__label" for="filter-category">Category</label>
      <select class="select" id="filter-category" name="category">
        <option value="">All categories</option>
        {
          taxonomy.categories.map((item) => (
            <option value={item.slug} selected={category === item.slug}>
              {item.name}
            </option>
          ))
        }
      </select>
    </div>

    <div class="filterbar__field">
      <label class="filterbar__label" for="filter-year">Year level</label>
      <select class="select" id="filter-year" name="year">
        {
          taxonomy.year_levels.map((item) => {
            const value = item.slug === "all" ? "" : item.slug;
            return (
              <option value={value} selected={year === value}>
                {item.name}
              </option>
            );
          })
        }
      </select>
    </div>

    <div class="filterbar__field">
      <label class="filterbar__label" for="filter-section">Section</label>
      <select class="select" id="filter-section" name="section">
        {
          taxonomy.sections.map((item) => {
            const value = item.slug === "all" ? "" : item.slug;
            return (
              <option value={value} selected={section === value}>
                {item.name}
              </option>
            );
          })
        }
      </select>
    </div>

    <div class="filterbar__actions">
      <button class="btn" type="submit">Apply</button>
      {
        isFiltered && (
          <a class="btn btn--ghost" href="/">
            Clear
          </a>
        )
      }
    </div>
  </form>

  {
    isFiltered && data.results.length > 0 && (
      <p class="filters__summary">
        Showing {activeCategory ? activeCategory.name.toLowerCase() : "all"} announcements
        {narrowedTo ? ` for ${narrowedTo}, plus those for everyone` : ""}
        {search ? ` matching "${search}"` : ""}.
      </p>
    )
  }

  {
    data.results.length === 0 ? (
      <div class="empty">
        <img src={LOGO_PATH} alt="" />
        <p>
          {isFiltered
            ? "No announcements match these filters yet."
            : "No announcements have been posted yet. Check back soon."}
        </p>
        {isFiltered && (
          <p>
            <a class="btn btn--ghost" href="/">
              Show all announcements
            </a>
          </p>
        )}
      </div>
    ) : (
      <ul class="card-list">
        {data.results.map((announcement) => (
          <AnnouncementCard
            announcement={announcement}
            tone={toneFor(announcement.category)}
          />
        ))}
      </ul>
    )
  }

  {
    (hasPrev || hasNext) && (
      <nav class="pager" aria-label="Pagination">
        {hasPrev ? (
          <a class="btn btn--ghost" href={pageHref(page - 1)} rel="prev">
            &larr; Newer
          </a>
        ) : (
          <span />
        )}
        <span class="pager__status">Page {page}</span>
        {hasNext ? (
          <a class="btn btn--ghost" href={pageHref(page + 1)} rel="next">
            Older &rarr;
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
</BaseLayout>

<script is:inline>
  // Progressive enhancement: apply a dropdown the moment it changes. Without
  // JavaScript the Apply button does the same job, so nothing is lost.
  (function () {
    var form = document.getElementById("filter-form");
    if (!form) return;
    Array.prototype.forEach.call(form.querySelectorAll("select"), function (select) {
      select.addEventListener("change", function () {
        form.submit();
      });
    });
  })();
</script>

<style>
  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 28px;
  }

  .pager__status {
    font-size: 0.86rem;
    color: var(--muted);
  }
</style>
