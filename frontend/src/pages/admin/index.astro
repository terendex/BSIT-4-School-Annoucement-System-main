---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminDashboard from "../../components/admin/AdminDashboard.tsx";
---

<BaseLayout
  title="Dashboard"
  description="Post and manage class announcements."
  canonicalPath="/admin"
  noindex={true}
>
  <div class="page-heading">
    <h1>Dashboard</h1>
  </div>

  <!--
    client:only - the dashboard is entirely client-driven (JWT in memory), so
    there is nothing useful to server-render and no session on the server.
  -->
  <AdminDashboard client:only="react" />

  <noscript>
    <p class="alert alert--error">
      The dashboard needs JavaScript. Classmates can still read every
      announcement without it.
    </p>
  </noscript>
</BaseLayout>

<style is:global>
  /* ------------------------------------------------------------- modals */
  .modal {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: rgba(9, 12, 32, 0.55);
    backdrop-filter: blur(2px);
    display: grid;
    place-items: center;
    padding: 20px;
    overflow-y: auto;
  }

  .modal__panel {
    background: var(--paper);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-height: calc(100vh - 40px);
    max-height: calc(100dvh - 40px);
    display: flex;
    flex-direction: column;
    animation: modal-in 0.16s ease-out;
  }

  @keyframes modal-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.99);
    }
  }

  .modal__panel--sm {
    max-width: 440px;
  }

  .modal__panel--md {
    max-width: 620px;
  }

  .modal__panel--lg {
    max-width: 820px;
  }

  /* The poster maker needs room for the form and the preview side by side. */
  .modal__panel--xl {
    max-width: 1120px;
  }

  .modal__header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
    background: var(--navy-50);
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .modal__title {
    font-size: 1.08rem;
    margin: 0;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .modal__close {
    border: none;
    background: transparent;
    font-size: 1.7rem;
    line-height: 1;
    color: var(--muted);
    cursor: pointer;
    padding: 0 4px;
  }

  .modal__close:hover:not(:disabled) {
    color: var(--navy-800);
  }

  .modal__body {
    padding: 20px;
    overflow-y: auto;
  }

  .modal__footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 14px 20px;
    border-top: 1px solid var(--line);
    background: var(--navy-50);
    border-radius: 0 0 var(--radius) var(--radius);
  }

  /* ---------------------------------------------------------- admin bar */
  .admin-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    justify-content: space-between;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px 18px;
    margin-bottom: 18px;
    box-shadow: var(--shadow-sm);
  }

  .admin-bar__who {
    margin: 0;
    font-size: 0.92rem;
  }

  .admin-bar__actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }

  /* A hairline before the housekeeping buttons, so "New announcement" reads as
     the one thing this page is for. */
  .admin-bar__divider {
    width: 1px;
    align-self: stretch;
    min-height: 26px;
    background: var(--line);
    margin: 0 2px;
  }

  @media (max-width: 700px) {
    .admin-bar__divider {
      display: none;
    }
  }

  .searchbar {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .searchbar .input {
    max-width: 340px;
  }

  /* .select inherits width:100% from the shared field styles, which would put
     each dropdown on a row of its own inside this flex bar. */
  .searchbar .select {
    width: auto;
    min-width: 170px;
    flex: 0 1 auto;
  }

  /* -------------------------------------------------------- admin table */
  .table-scroll {
    overflow-x: auto;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    /* Fixed layout, so the columns below get the widths they are given.
       Under auto layout every nowrap column took what it wanted and the
       title - the only wrappable one - was squeezed to a word per line. */
    table-layout: fixed;
    /* The page is 960px wide with 20px padding either side, so anything over
       920px guarantees a horizontal scrollbar at full width. */
    min-width: 880px;
  }

  /* Pixel widths for the columns whose content is a known size, and `auto`
     for the title so it absorbs whatever is left - and grows on a wide
     screen instead of everything stretching. Percentages were guesswork:
     they left the four action buttons a few pixels short of fitting. */
  .admin-table th:nth-child(1) { width: auto; }   /* title    - the remainder */
  .admin-table th:nth-child(2) { width: 150px; }  /* filed under */
  .admin-table th:nth-child(3) { width: 112px; }  /* status */
  .admin-table th:nth-child(4) { width: 125px; }  /* updated */
  .admin-table th:nth-child(5) { width: 265px; }  /* Edit Files Share Delete */

  /* Publishers: three buttons, and "Resend invite" is the long one. */
  .admin-table--compact th:nth-child(1) { width: auto; }   /* account */
  .admin-table--compact th:nth-child(2) { width: 150px; }  /* status */
  .admin-table--compact th:nth-child(3) { width: 70px; }   /* posts */
  .admin-table--compact th:nth-child(4) { width: 285px; }

  .admin-table th,
  .admin-table td {
    text-align: left;
    padding: 14px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }

  /* Scanning a row of six columns is easier with the row itself responding. */
  .admin-table tbody tr {
    transition: background 0.12s ease;
  }

  .admin-table tbody tr:hover {
    background: var(--navy-50);
  }

  .admin-table th {
    background: var(--navy-50);
    font-size: 0.76rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
    /* "Posted by" was folding onto two lines and deepening every header. */
    white-space: nowrap;
  }

  /* The Publishers table has four columns, not six, and lives inside an
     820px modal - the dashboard's min-width would make it scroll sideways for
     no reason. */
  .admin-table--compact {
    /* Fits inside the 820px modal without scrolling, while leaving room for
       "Resend invite", "Disable" and "Remove" on one line. */
    min-width: 700px;
  }

  /* The badges are nowrap already, so they need no minimum of their own -
     one was previously stealing width from the title. */
  .admin-table__filed .tag {
    margin: 2px 4px 2px 0;
  }

  .admin-table tr:last-child td {
    border-bottom: none;
  }

  .admin-table__title {
    display: block;
    font-weight: 600;
    color: var(--navy-800);
    text-decoration: none;
  }

  .admin-table__title:hover {
    text-decoration: underline;
  }

  .admin-table__nowrap {
    white-space: nowrap;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .admin-table__actions {
    display: flex;
    gap: 5px;
    justify-content: flex-end;
    flex-wrap: nowrap;
  }

  /* Tighter than a standalone button: four of these share one column. */
  .admin-table__actions .btn {
    white-space: nowrap;
    padding: 6px 9px;
  }

  /* A long unbroken title must wrap rather than widen the fixed column. */
  .admin-table__title {
    overflow-wrap: anywhere;
  }

  button.tag {
    cursor: pointer;
    font-family: inherit;
  }

  /* -------------------------------------------------------- attachments */
  .upload-panel {
    background: var(--navy-50);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 16px;
  }

  .upload-panel__row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  /* ---------------------------------------------------------- poster maker */
  .poster {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
    gap: 24px;
    align-items: start;
  }

  .poster__form .field:last-child {
    margin-bottom: 0;
  }

  .poster__textarea {
    min-height: 0;
  }

  /*
    Lists and schedules stay monospaced - the columns and the indents that
    drive the layout are only visible when the characters line up. A plain
    paragraph is just a paragraph.
  */
  .poster__textarea--prose {
    font-family: var(--font);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* The preview follows the form down a long list of fields. */
  .poster__preview {
    position: sticky;
    top: 0;
  }

  .poster__stage {
    background: var(--navy-50);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 12px;
    display: grid;
    place-items: center;
  }

  /*
    The canvas is drawn at 1200px wide whatever the preview is; letting CSS
    scale it keeps the poster crisp on the screen and full size in the file.
  */
  .poster__canvas {
    width: 100%;
    height: auto;
    max-height: 62vh;
    object-fit: contain;
    box-shadow: var(--shadow-sm);
    background: var(--paper);
  }

  .poster__meta {
    margin-top: 10px;
    text-align: center;
  }

  .attachment-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .attachment {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .attachment__thumb {
    flex: none;
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 6px;
    background: var(--navy-50);
  }

  .attachment__thumb--file {
    display: grid;
    place-items: center;
    background: var(--navy-700);
    color: #fff;
    font-size: 0.66rem;
    font-weight: 700;
  }

  .attachment__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .attachment__info a {
    font-weight: 600;
    word-break: break-all;
  }

  .attachment__confirm {
    display: flex;
    gap: 6px;
  }

  /* ------------------------------------------------------------- mobile */
  /* Below this width the five-column table cannot be read, so each row
     becomes a card and the action buttons come within thumb reach. */
  @media (max-width: 700px), (pointer: coarse) {
    .modal__close {
      width: 44px;
      height: 44px;
      padding: 0;
      flex: none;
    }
  }

  @media (max-width: 700px) {
    .table-scroll {
      overflow-x: visible;
      background: none;
      border: none;
      box-shadow: none;
      border-radius: 0;
    }

    .admin-table {
      display: block;
      min-width: 0;
      font-size: 0.95rem;
    }

    .admin-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }

    .admin-table tbody,
    .admin-table tr,
    .admin-table td {
      display: block;
      width: 100%;
    }

    .admin-table tr {
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      padding: 14px 16px;
      margin-bottom: 12px;
    }

    .admin-table td {
      border-bottom: none;
      padding: 5px 0;
    }

    /* Cells that lost their column header carry it inline instead. */
    .admin-table td[data-label] {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .admin-table td[data-label]::before {
      content: attr(data-label);
      font-size: 0.72rem;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--muted);
    }

    .admin-table__nowrap {
      white-space: normal;
      text-align: right;
    }

    .admin-table__actions {
      justify-content: stretch;
      margin-top: 10px;
      gap: 8px;
      /* The desktop rule is nowrap, which would crush four buttons into a
         360px row. On a card they get two comfortable rows instead. */
      flex-wrap: wrap;
    }

    .admin-table__actions .btn {
      flex: 1 1 calc(50% - 4px);
    }

    .admin-table__actions .btn {
      flex: 1 1 0;
      min-width: 0;
    }

    .admin-bar__actions {
      width: 100%;
    }

    .admin-bar__actions .btn {
      flex: 1 1 auto;
    }

    .searchbar .input {
      max-width: none;
      flex: 1 1 100%;
    }

    .searchbar .select {
      flex: 1 1 45%;
      min-width: 0;
    }
  }

  @media (max-width: 900px) {
    .poster {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Stacked, the preview leads so the words being typed are visible. */
    .poster__preview {
      position: static;
      order: -1;
    }

    .poster__canvas {
      max-height: 44vh;
    }
  }

  @media (max-width: 640px) {
    .modal {
      padding: 10px;
      align-items: flex-end;
    }

    .modal__panel {
      max-height: calc(100dvh - 20px);
    }

    .attachment {
      flex-wrap: wrap;
    }

    .upload-panel__row {
      flex-direction: column;
      gap: 0;
    }

    .upload-panel__row .field {
      margin-bottom: 14px;
      width: 100%;
    }
  }
</style>
