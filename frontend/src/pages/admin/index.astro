---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminDashboard from "../../components/admin/AdminDashboard.tsx";
---

<BaseLayout
  title="Admin dashboard"
  description="Manage class announcements."
  canonicalPath="/admin"
  noindex={true}
>
  <div class="page-heading">
    <h1>Admin dashboard</h1>
  </div>

  <!--
    client:only - the dashboard is entirely client-driven (JWT in memory), so
    there is nothing useful to server-render and no session on the server.
  -->
  <AdminDashboard client:only="react" />

  <noscript>
    <p class="alert alert--error">
      The admin dashboard needs JavaScript. Classmates can still read every
      announcement without it.
    </p>
  </noscript>
</BaseLayout>

<style is:global>
  /* ------------------------------------------------------------- modals */
  .modal {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: rgba(9, 12, 32, 0.55);
    backdrop-filter: blur(2px);
    display: grid;
    place-items: center;
    padding: 20px;
    overflow-y: auto;
  }

  .modal__panel {
    background: var(--paper);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-height: calc(100vh - 40px);
    display: flex;
    flex-direction: column;
    animation: modal-in 0.16s ease-out;
  }

  @keyframes modal-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.99);
    }
  }

  .modal__panel--sm {
    max-width: 440px;
  }

  .modal__panel--md {
    max-width: 620px;
  }

  .modal__panel--lg {
    max-width: 820px;
  }

  .modal__header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
    background: var(--navy-50);
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .modal__title {
    font-size: 1.08rem;
    margin: 0;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .modal__close {
    border: none;
    background: transparent;
    font-size: 1.7rem;
    line-height: 1;
    color: var(--muted);
    cursor: pointer;
    padding: 0 4px;
  }

  .modal__close:hover:not(:disabled) {
    color: var(--navy-800);
  }

  .modal__body {
    padding: 20px;
    overflow-y: auto;
  }

  .modal__footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 14px 20px;
    border-top: 1px solid var(--line);
    background: var(--navy-50);
    border-radius: 0 0 var(--radius) var(--radius);
  }

  /* ---------------------------------------------------------- admin bar */
  .admin-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px 18px;
    margin-bottom: 18px;
    box-shadow: var(--shadow-sm);
  }

  .admin-bar__who {
    margin: 0;
    font-size: 0.92rem;
  }

  .admin-bar__actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .searchbar {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .searchbar .input {
    max-width: 340px;
  }

  /* -------------------------------------------------------- admin table */
  .table-scroll {
    overflow-x: auto;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    min-width: 760px;
  }

  .admin-table th,
  .admin-table td {
    text-align: left;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }

  .admin-table th {
    background: var(--navy-50);
    font-size: 0.76rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .admin-table tr:last-child td {
    border-bottom: none;
  }

  .admin-table__title {
    display: block;
    font-weight: 600;
    color: var(--navy-800);
    text-decoration: none;
  }

  .admin-table__title:hover {
    text-decoration: underline;
  }

  .admin-table__nowrap {
    white-space: nowrap;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .admin-table__actions {
    display: flex;
    gap: 6px;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  button.tag {
    cursor: pointer;
    font-family: inherit;
  }

  /* -------------------------------------------------------- attachments */
  .upload-panel {
    background: var(--navy-50);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 16px;
  }

  .upload-panel__row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .attachment-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .attachment {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .attachment__thumb {
    flex: none;
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 6px;
    background: var(--navy-50);
  }

  .attachment__thumb--file {
    display: grid;
    place-items: center;
    background: var(--navy-700);
    color: #fff;
    font-size: 0.66rem;
    font-weight: 700;
  }

  .attachment__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .attachment__info a {
    font-weight: 600;
    word-break: break-all;
  }

  .attachment__confirm {
    display: flex;
    gap: 6px;
  }

  @media (max-width: 640px) {
    .modal {
      padding: 10px;
    }

    .attachment {
      flex-wrap: wrap;
    }
  }
</style>
