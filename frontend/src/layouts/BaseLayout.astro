---
import AutoRefresh from "../components/AutoRefresh.tsx";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { OG_HEIGHT, OG_WIDTH, ogImageFor } from "../lib/ogImage";
import {
  FB_APP_ID,
  OG_FALLBACK_PATH,
  SITE_NAME,
  SITE_TAGLINE,
  absoluteUrl,
} from "../lib/config";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Absolute or site-relative image URL. Falls back to the school seal. */
  image?: string | null;
  imageAlt?: string;
  /** Pixel size of `image`. Messenger needs these to draw the large card. */
  imageWidth?: number | null;
  imageHeight?: number | null;
  imageType?: string | null;
  /** Path only, e.g. /a/exam-schedule */
  canonicalPath?: string;
  ogType?: "website" | "article";
  publishedTime?: string | null;
  modifiedTime?: string | null;
  noindex?: boolean;
  /** Fingerprint used to notice new/edited posts. Omit to disable polling. */
  refreshSignature?: string | null;
  /** Set on an announcement page so it watches that post specifically. */
  refreshSlug?: string;
  /** Active list filters, so polling asks about the same subset. */
  refreshQuery?: string;
}

const {
  title,
  description = SITE_TAGLINE,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  imageType,
  canonicalPath = Astro.url.pathname,
  ogType = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
  refreshSignature = null,
  refreshSlug,
  refreshQuery,
} = Astro.props;

const pageTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonical = absoluteUrl(canonicalPath);
// The announcement's first photo, padded to the card's shape so nothing is
// cropped; otherwise the seal on a ready-made 1200x630 canvas. Either way
// Messenger gets a picture it will not slice.
const preview = image
  ? ogImageFor(absoluteUrl(image), imageWidth ?? null, imageHeight ?? null, imageType ?? null)
  : {
      url: absoluteUrl(OG_FALLBACK_PATH),
      width: OG_WIDTH,
      height: OG_HEIGHT,
      type: "image/png",
    };
const ogImage = preview.url;
const ogImageAlt = imageAlt || `${SITE_NAME} logo`;
// Facebook trusts these tags rather than downloading first, so they decide
// whether it draws the large card or a small thumbnail.
const ogImageWidth = preview.width;
const ogImageHeight = preview.height;
const ogImageType = preview.type;
// Keep the OG description inside Messenger's preview budget.
const ogDescription = description.length > 200 ? `${description.slice(0, 197)}...` : description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={ogDescription} />
    <link rel="canonical" href={canonical} />
    <!-- Tab icon is the seal's crest alone; the full seal is illegible at 16px. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1f2a6b" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph: what Facebook Messenger reads for the link preview. -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta property="og:locale" content="en_PH" />
    {FB_APP_ID && <meta property="fb:app_id" content={FB_APP_ID} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <Header />
    {
      refreshSignature && (
        <AutoRefresh
          initial={refreshSignature}
          slug={refreshSlug}
          query={refreshQuery}
          client:idle
        />
      )
    }
    <main class="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
