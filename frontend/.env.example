# Django API root - no trailing slash.
# Local:      http://127.0.0.1:8000
# Production: https://<your-service>.up.railway.app
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Public origin of THIS site. Open Graph URLs are built from it, so it must be
# the real https:// domain in production or Messenger previews will break.
PUBLIC_SITE_URL=http://localhost:4321

# Optional branding overrides.
PUBLIC_SITE_NAME=Terendex's Announcement Services
PUBLIC_SITE_TAGLINE=Announcements for BSIT 4 - Saint Louis College, City of San Fernando, La Union.
