# Both URLs below are OPTIONAL: src/lib/config.ts already defaults to the
# deployed Railway and Vercel domains for production builds, and to localhost
# for `astro dev`. Set them only to point at somewhere different.
#
# Django API root - no trailing slash.
# Local:      http://127.0.0.1:8000
# Production: https://<your-service>.up.railway.app
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Public origin of THIS site. Open Graph URLs are built from it, so it must be
# the real https:// domain in production or Messenger previews will break.
PUBLIC_SITE_URL=http://localhost:4321

# Optional branding overrides.
PUBLIC_SITE_NAME=Terendex's Announcement Services
PUBLIC_SITE_TAGLINE=Announcements for BSIT students - Saint Louis College, City of San Fernando, La Union.

# Optional: Facebook App ID, only for Facebook Insights (share analytics).
# Link previews work without it; setting it clears the Sharing Debugger warning.
PUBLIC_FB_APP_ID=
