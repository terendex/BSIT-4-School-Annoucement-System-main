# ---- Core ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Comma separated. The platform's own hostname is added automatically
# (RAILWAY_PUBLIC_DOMAIN / RENDER_EXTERNAL_HOSTNAME), so this rarely changes.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# Leave blank locally to use SQLite.
# On Railway set this to the reference ${{Postgres.DATABASE_URL}} in the dashboard.
DATABASE_URL=
# Leave unset to auto-detect. Railway private networking needs it off; most
# other managed Postgres hosts need it on.
# DATABASE_SSL_REQUIRE=

# ---- CORS / CSRF (frontend origin, no trailing slash) ----
# In production this is the Vercel domain, e.g. https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:4321
# Optional extra origins, comma separated (e.g. preview deploys)
EXTRA_CORS_ORIGINS=

# ---- Cloudinary (leave blank locally to store uploads on disk) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=announcements

# ---- Bootstrap admin (used by `manage.py ensure_admin`) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---- Security toggles (set True in production) ----
DJANGO_SECURE_SSL_REDIRECT=False
