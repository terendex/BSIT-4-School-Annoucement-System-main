# ---- Core ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Comma separated. The platform's own hostname is added automatically
# (RAILWAY_PUBLIC_DOMAIN / RENDER_EXTERNAL_HOSTNAME), so this rarely changes.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# Leave blank locally to use SQLite.
# On Railway set this to the reference ${{Postgres.DATABASE_URL}} in the dashboard.
DATABASE_URL=
# Leave unset to auto-detect. Railway private networking needs it off; most
# other managed Postgres hosts need it on.
# DATABASE_SSL_REQUIRE=

# ---- CORS / CSRF (frontend origin, no trailing slash) ----
# In production this is the Vercel domain, e.g. https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:4321
# Optional extra origins, comma separated (e.g. preview deploys)
EXTRA_CORS_ORIGINS=

# ---- Cloudinary (leave blank locally to store uploads on disk) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=announcements

# ---- Email: Brevo HTTP API (preferred), used to send publisher invites ----
# Most container hosts - Railway included - block outbound SMTP. The symptom is
# "OSError: [Errno 101] Network is unreachable" on port 587, and no credential
# fixes it. Brevo's HTTP API goes over 443 and works from there.
#
# This must be an API KEY (xkeysib-...) from Brevo's SMTP & API page, API Keys
# tab. An SMTP key (xsmtpsib-...) is a different credential and will not work.
BREVO_API_KEY=
# An address verified as a sender in the Brevo account.
EMAIL_SENDER=

# ---- Email: Gmail SMTP (fallback, only where outbound SMTP is allowed) ----
# EMAIL_HOST_PASSWORD must be a Google "App Password" - 16 characters generated
# at myaccount.google.com/apppasswords with 2-Step Verification switched on.
# A normal Gmail password will be refused by the SMTP server.
# Leave both blank locally: invites are printed to the console instead.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Shown as the sender name and in the invite email.
SITE_NAME=SLC Announcements
# Days a mailed temporary password stays usable.
INVITE_EXPIRY_DAYS=7

# ---- Bootstrap admin (used by `manage.py ensure_admin`) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---- Security toggles (set True in production) ----
DJANGO_SECURE_SSL_REDIRECT=False
