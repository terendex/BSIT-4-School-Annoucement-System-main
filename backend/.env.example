# ---- Core ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Comma separated. On Render use: your-service.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# Leave blank locally to use SQLite. On Render paste the Internal Database URL.
DATABASE_URL=

# ---- CORS / CSRF (frontend origin, no trailing slash) ----
FRONTEND_ORIGIN=http://localhost:4321
# Optional extra origins, comma separated (e.g. preview deploys)
EXTRA_CORS_ORIGINS=

# ---- Cloudinary (leave blank locally to store uploads on disk) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=announcements

# ---- Bootstrap admin (used by `manage.py ensure_admin`) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---- Security toggles (set True in production) ----
DJANGO_SECURE_SSL_REDIRECT=False
